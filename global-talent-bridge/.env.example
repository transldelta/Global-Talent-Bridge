# ─────────────────────────────────────────────────────────────
# Global Talent Bridge — Environment Variables
# ─────────────────────────────────────────────────────────────
# Kopiere diese Datei als .env.local und fülle die Werte aus.
# NIEMALS .env.local committen — es steht in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase (öffentlich — nur für Client sichtbar) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase Service Role (NUR serverseitig — NIEMALS im Client verwenden) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin E-Mails (kommagetrennt — NUR serverseitig) ─────────
ADMIN_EMAILS=transl.delta@gmail.com

# ── Buyer Demo Mode ───────────────────────────────────────────
# Aktiviert synthetische Demo-Daten auf /admin/data-room.
# Keine echten Kunden oder Umsätze. Alle Demo-Daten: demo=true.
# NEXT_PUBLIC_BUYER_DEMO_MODE=true   # Client-seitig (optional)
# BUYER_DEMO_MODE=true               # Server-seitig (API + Server Components)

# ═════════════════════════════════════════════════════════════
# ── Outreach E-Mail-Provider ──────────────────────────────────
# ═════════════════════════════════════════════════════════════
#
# SICHERHEITS-PRINZIPIEN:
# ─────────────────────────────────────────────────────────────
# • "none" ist der sichere Default — kein Versand ohne bewusste Konfiguration.
# • Kein automatischer Versand — immer nur nach expliziter JA-Freigabe.
# • Kein Massenversand — immer nur einzelne freigegebene Drafts.
# • LinkedIn / WhatsApp / Phone werden NIE automatisch gesendet.
# • Signatur immer: "Global Talent Bridge Team"
#
# Provider wählen:
#   none   = sicherer Default, kein Versand möglich
#   resend = Empfehlung für Produktion (transactional email API)
#   smtp   = eigener SMTP-Server (noch nicht vollständig implementiert)
# ─────────────────────────────────────────────────────────────

OUTREACH_EMAIL_PROVIDER=none
OUTREACH_FROM_EMAIL=

# ── Resend (wenn OUTREACH_EMAIL_PROVIDER=resend) ──────────────
# API-Key aus https://resend.com/api-keys
# NIEMALS committen!
RESEND_API_KEY=

# ── SMTP (wenn OUTREACH_EMAIL_PROVIDER=smtp) ─────────────────
# SMTP-Versand ist noch ein Placeholder — bitte resend verwenden.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ── Test-Modus ────────────────────────────────────────────────
# Wenn auf "true": Test-Warnung wird in Provider-Status angezeigt.
# Kein Effekt auf tatsächlichen Versand — ist nur eine Warnanzeige.
# OUTREACH_TEST_MODE=true
