# ─────────────────────────────────────────────────────────────
# CorridorWork — Environment Variables
# ─────────────────────────────────────────────────────────────
# Kopiere diese Datei als .env.local und fülle die Werte aus.
# NIEMALS .env.local committen — es steht in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase (öffentlich — nur für Client sichtbar) ───────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase Service Role (NUR serverseitig — NIEMALS im Client verwenden) ──
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron Secret (für /api/cron/cwo-daily-runner) ─────────────
# Generieren: openssl rand -hex 32
# Wird als Header gesetzt: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── Public Base URL ───────────────────────────────────────────
# Produktion: https://corridorwork.com
# Lokal: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://corridorwork.com

# ── Admin E-Mails (kommagetrennt — NUR serverseitig) ─────────
ADMIN_EMAILS=transl.delta@gmail.com

# ─────────────────────────────────────────────────────────────
# ── E-Mail-Provider ───────────────────────────────────────────
# ─────────────────────────────────────────────────────────────
#
# SICHERHEITS-PRINZIPIEN:
# ─────────────────────────────────────────────────────────────
# • "none" ist der sichere Default — kein Versand ohne bewusste Konfiguration.
# • Kein automatischer Versand — immer nur nach expliziter Freigabe.
# • Kein Massenversand.
# • EMAIL_PROVIDER=none bedeutet: kein transaktionaler E-Mail-Versand möglich.
# • OUTREACH_EMAIL_PROVIDER=none bedeutet: kein Outreach möglich.
#
# Provider wählen:
#   none   = sicherer Default, kein Versand möglich
#   resend = Empfehlung für Produktion (transactional email API)
# ─────────────────────────────────────────────────────────────

# Transaktionale E-Mails (Login, Bestätigungen)
EMAIL_PROVIDER=none

# Outreach E-Mails (Kontaktaufnahme mit Leads)
OUTREACH_EMAIL_PROVIDER=none
OUTREACH_FROM_EMAIL=

# ── Resend (wenn OUTREACH_EMAIL_PROVIDER=resend) ──────────────
# API-Key aus https://resend.com/api-keys
# NIEMALS committen!
RESEND_API_KEY=

# ── SMTP (wenn OUTREACH_EMAIL_PROVIDER=smtp) ─────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ─────────────────────────────────────────────────────────────
# ── Test / Entwicklung ────────────────────────────────────────
# ─────────────────────────────────────────────────────────────

# Auto-Application Messages in Test-Modus deaktivieren
ENABLE_TEST_AUTO_APPLICATION_MESSAGE=false

# Buyer Demo Mode (synthetische Demo-Daten)
# NEXT_PUBLIC_BUYER_DEMO_MODE=true
# BUYER_DEMO_MODE=true
